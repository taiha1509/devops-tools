# {{ marker }}
# Generated by scaffolder {{ template_name }} {{ template_version }}.
#
# Same quality and build jobs as python-fastapi. Deploy differs: a worker scales
# on queue depth rather than on request rate, and has no load balancer to drain,
# so the rollout strategy is not the same.
name: CI

on:
  pull_request:
  push:
    branches: [main]

concurrency:
  group: ${{ '{{' }} github.workflow {{ '}}' }}-${{ '{{' }} github.ref {{ '}}' }}
  cancel-in-progress: ${{ '{{' }} github.event_name == 'pull_request' {{ '}}' }}

permissions:
  contents: read

jobs:
  quality:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v4
      - uses: astral-sh/setup-uv@v4
        with:
          enable-cache: true
      - run: uv sync --frozen
      - run: uv run ruff check .
      - run: uv run ruff format --check .
      - run: uv run mypy --strict src
      - run: uv run pytest

  scaffold-drift:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - uses: actions/checkout@v4
      - run: scaffold check .
        continue-on-error: true

  build:
    needs: [quality]
    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      contents: read
      id-token: write
    steps:
      - uses: actions/checkout@v4
      - run: docker build -t {{ name }}:${{ '{{' }} github.sha {{ '}}' }} .
      - uses: aquasecurity/trivy-action@0.28.0
        with:
          image-ref: "{{ name }}:${{ '{{' }} github.sha {{ '}}' }}"
          severity: "CRITICAL"
          exit-code: "1"
          ignore-unfixed: true

  deploy:
    needs: [build]
    if: github.ref == 'refs/heads/main'
    runs-on: ubuntu-latest
    timeout-minutes: 20
    environment: production
    permissions:
      id-token: write
      contents: read
    steps:
      - uses: actions/checkout@v4

      - name: Deploy gate
        uses: your-org/deploy-gate@v1
        with:
          environment: production
          freeze-windows: .github/freeze.yaml

      - name: Deploy
        # TODO: wire to the org's reusable worker-deploy workflow.
        #
        # Worth being explicit that this is not the HTTP service's deploy: there
        # is no target group to register with and no readiness gate to wait on,
        # so "is it healthy" has to be answered by queue depth falling and the
        # liveness file staying fresh. A copy-pasted service deploy would wait
        # forever for a health check that will never pass.
        run: echo "TODO: worker deploy"
