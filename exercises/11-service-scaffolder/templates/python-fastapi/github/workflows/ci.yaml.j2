# {{ marker }}
# Generated by scaffolder {{ template_name }} {{ template_version }}.
#
# This file is the reason the scaffolder exists. The problem statement: every new
# service copies the last one, so every new service inherits the deprecated
# action, the missing timeout-minutes, and the Dockerfile that runs as root. Fix
# it here once and `scaffold check` finds every service that has not caught up.
name: CI

on:
  pull_request:
  push:
    branches: [main]

# Cancel superseded runs on the same PR. Without this, a branch pushed five times
# runs CI five times concurrently and the queue is full of work nobody wants.
concurrency:
  group: ${{ '{{' }} github.workflow {{ '}}' }}-${{ '{{' }} github.ref {{ '}}' }}
  cancel-in-progress: ${{ '{{' }} github.event_name == 'pull_request' {{ '}}' }}

permissions:
  contents: read

jobs:
  quality:
    runs-on: ubuntu-latest
    # Always set this. The default is 360 minutes, so one hung job burns six
    # hours of runner minutes before anyone notices.
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v4
      - uses: astral-sh/setup-uv@v4
        with:
          enable-cache: true
      - run: uv sync --frozen
      - run: uv run ruff check .
      - run: uv run ruff format --check .
      - run: uv run mypy --strict src
      - run: uv run pytest

  scaffold-drift:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - uses: actions/checkout@v4
      # The feature that makes the scaffolder more than a one-off generator:
      # every service checks itself against the current template on every PR.
      # Non-blocking at first - make it required once the signal is trusted.
      - run: scaffold check .
        continue-on-error: true

  build:
    needs: [quality]
    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      contents: read
      id-token: write  # OIDC. No long-lived AWS keys in secrets.
    steps:
      - uses: actions/checkout@v4

      - name: Build image
        run: docker build -t {{ name }}:${{ '{{' }} github.sha {{ '}}' }} .

      - name: Scan image
        uses: aquasecurity/trivy-action@0.28.0
        with:
          image-ref: "{{ name }}:${{ '{{' }} github.sha {{ '}}' }}"
          # Fail on what you can act on. `--severity CRITICAL` only, at first:
          # a scanner that reports 400 findings on day one gets switched off on
          # day two, and then you have no scanning at all.
          severity: "CRITICAL"
          exit-code: "1"
          ignore-unfixed: true

  deploy:
    needs: [build]
    if: github.ref == 'refs/heads/main'
    runs-on: ubuntu-latest
    timeout-minutes: 20
    environment: production
    permissions:
      id-token: write
      contents: read
    steps:
      - uses: actions/checkout@v4

      # E07's gate, wired in by default. A freeze window that every new service
      # respects without anyone remembering to add it is the whole argument for
      # scaffolding over documentation.
      - name: Deploy gate
        uses: your-org/deploy-gate@v1
        with:
          environment: production
          freeze-windows: .github/freeze.yaml

      - name: Deploy
        run: echo "TODO: wire to the org's reusable deploy workflow"
