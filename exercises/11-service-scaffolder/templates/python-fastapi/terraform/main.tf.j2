# {{ marker }}
# Generated by scaffolder {{ template_name }} {{ template_version }}. Edits will be
# overwritten on regeneration - change the template instead.

terraform {
  required_version = ">= 1.9"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }

  # TODO: point at the org's state bucket. Local state for a deployed service is
  # one laptop away from being lost, and two engineers away from being corrupted.
  backend "s3" {
    # bucket       = "your-org-tfstate"
    key          = "services/{{ name }}/terraform.tfstate"
    region       = "eu-west-1"
    encrypt      = true
    use_lockfile = true
  }
}

# Required tags, already populated. This is the quiet payoff of scaffolding:
# E04's inventory can answer "who owns this?" and E12's cost reporter can
# attribute spend, for every service, without anyone remembering to tag anything.
# An untagged resource is a line item nobody can explain three months later.
locals {
  required_tags = {
    Service     = "{{ name }}"
    Team        = "{{ team }}"
    ManagedBy   = "terraform"
    Repository  = "{{ name }}"
    Template    = "{{ template_name }}@{{ template_version }}"
  }
}

provider "aws" {
  region = var.region

  # Applied to everything this provider creates, so a new resource cannot be
  # born untagged.
  default_tags {
    tags = local.required_tags
  }
}

variable "region" {
  type        = string
  description = "AWS region for this service's resources."
  default     = "eu-west-1"
}

variable "environment" {
  type        = string
  description = "Deployment environment."

  validation {
    condition     = contains(["preview", "staging", "production"], var.environment)
    error_message = "environment must be one of: preview, staging, production."
  }
}

resource "aws_cloudwatch_log_group" "service" {
  name              = "/aws/{{ name }}/${var.environment}"
  retention_in_days = 30
  # Note the retention. The default is "never expire", which is the
  # misconfiguration behind E12's problem statement - 400GB/day to CloudWatch,
  # unnoticed for two months. A generated default of 30 days means no service
  # ever ships with that bug again.
}

